# Copy this file to backend/.env; never commit backend/.env.
# Local-only credentials, matching compose.yaml.
DATABASE_URL=postgresql+psycopg://branch_office:local_dev_password@localhost:5432/branch_office
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
COOKIE_SECURE=false
# Replace for production; use a randomly generated secret, HTTPS origins and real hosts.
RATE_LIMIT_SECRET=local-development-only-not-for-production
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
